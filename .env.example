# ==============================================================================
# SentinelLog Environment Configuration Template (.env.example)
# Copy to .env and set appropriate values.
# NEVER commit .env containing real secrets or credentials to git.
# ==============================================================================

# Authentication Controls
SENTINELLOG_AUTH_ENABLED=false
SENTINELLOG_API_KEY=example_api_key_must_be_at_least_16_chars_long
SENTINELLOG_ANALYST_API_KEY=example_analyst_key_must_be_at_least_16_chars
SENTINELLOG_OPERATOR_API_KEY=example_operator_key_must_be_at_least_16_chars

# CORS Allowed Origins (Comma-separated or JSON array)
SENTINELLOG_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payload & Request Bounds (Bytes)
SENTINELLOG_MAX_REQUEST_BYTES=1048576

# Sliding Window Rate Limiting
SENTINELLOG_RATE_LIMIT_ENABLED=true
SENTINELLOG_RATE_LIMIT_REQUESTS=120
SENTINELLOG_RATE_LIMIT_WINDOW_SECONDS=60

# Trusted Reverse Proxies (Comma-separated IPs)
SENTINELLOG_TRUSTED_PROXIES=127.0.0.1,::1

# Operational Environment & Debug Flags
SENTINELLOG_DEBUG=false
SENTINELLOG_ENFORCE_PRODUCTION_MODE=false
