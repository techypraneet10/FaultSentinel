# Virtual Environments
.venv/
venv/
env/
ENV/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class

# Testing & Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
*.log
logs/

# Build and Distribution
build/
dist/
*.egg-info/

# Data: Ignore raw downloaded log files and large binary/archive/processed artifacts
# but allow directories, .gitkeep, metadata, manifests, and reports to be tracked
data/raw/*/*.log
data/raw/*/*.zip
data/raw/*/*.tar.gz
data/raw/*/*.csv
data/raw/**/*.log
data/raw/**/*.zip
data/raw/**/*.tar.gz
data/raw/**/*.csv
data/processed/*/*.jsonl
data/processed/*/*.parquet
data/processed/**/*.jsonl
data/processed/**/*.parquet
!data/**/.gitkeep
!data/**/manifest.json
!data/**/data_quality_report.json
!data/**/MANIFEST.md

# Experiment artifacts and checkpoints (ignore binaries, track manifests and reports)
*.joblib
*.pkl
*.pt
results/**/model.joblib
!results/**/manifest.json
!results/**/diagnostics.json
!results/**/comparison_report.*
!results/**/.gitkeep
!results/README.md
models/*
!models/.gitkeep
checkpoints/
